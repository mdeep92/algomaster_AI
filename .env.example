# GEMINI_API_KEY: Required for Gemini AI API calls.
# Used by the backend server (server/index.ts) ONLY — it is no longer bundled
# into the client. AI Studio injects this at runtime from user secrets;
# locally, copy this file to .env (or .env.local) and set your key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port the backend server listens on (default 3001).
PORT="3001"

# API_PROXY_TARGET: Where the Vite dev server proxies /api requests.
# Defaults to http://localhost:3001 (the backend above).
API_PROXY_TARGET="http://localhost:3001"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
