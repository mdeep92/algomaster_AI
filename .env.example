# ANTHROPIC_API_KEY: Required for Claude API calls.
# Used by the backend server (server/index.ts) ONLY — it is never bundled
# into the client. Copy this file to .env (or .env.local) and set your key.
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY="sk-ant-..."

# PORT: Port the backend server listens on (default 3001).
PORT="3001"

# API_PROXY_TARGET: Where the Vite dev server proxies /api requests.
# Defaults to http://localhost:3001 (the backend above).
API_PROXY_TARGET="http://localhost:3001"
